rules_version = '2';
// jetscan fixture for WEB-FIREBASE-010: the old Cloud Storage default.
service firebase.storage {
  match /b/{bucket}/o {
    // POSITIVE medium/needs_review: any signed-in user reads and overwrites every file.
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
