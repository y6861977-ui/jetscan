<?xml version="1.0" encoding="utf-8"?>
<!-- Field test 2026-11-12, pattern 13 (seen in a real mail client): minSdk 23 < 24, so the manifest
     flag applies on Android 6 while the network security config applies on 7.0+. Both permit
     cleartext: one fact, one NET-003 finding (the config's), naming both sources. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="com.jetscan.fixture.mail">
    <uses-sdk android:minSdkVersion="23" android:targetSdkVersion="34" />
    <application
        android:label="Mail"
        android:allowBackup="false"
        android:usesCleartextTraffic="true"
        android:networkSecurityConfig="@xml/network_security_config" />
</manifest>
