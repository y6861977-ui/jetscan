<?xml version="1.0" encoding="utf-8"?>
<!-- targetSdk 34 variant of legacy-16: provider not exported by default; the receiver keeps its
     intent-filter without android:exported (Android 12+ refuses to install that). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="com.jetscan.fixture.modern">
    <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="34" />
    <application
        android:label="Modern"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:usesCleartextTraffic="false"
        android:debuggable="false">
        <provider android:name=".Notes" android:authorities="com.jetscan.fixture.modern.notes" />
        <receiver android:name=".PushReceiver">
            <intent-filter>
                <action android:name="com.jetscan.fixture.PUSH" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
