<?xml version="1.0" encoding="utf-8"?>
<!-- Network security config NEGATIVE: no cleartext, system CAs only; user CAs only in debug-overrides. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <debug-overrides>
        <trust-anchors>
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>
