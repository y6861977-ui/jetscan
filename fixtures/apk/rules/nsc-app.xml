<?xml version="1.0" encoding="utf-8"?>
<!-- APK-NET-003 with a network security config. usesCleartextTraffic="true" is ignored on API 24+
     when a config exists, and minSdk is 24, so the flag itself is NOT a finding here. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="com.jetscan.fixture.nsc">
    <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="34" />
    <application
        android:label="NSC"
        android:allowBackup="false"
        android:usesCleartextTraffic="true"
        android:networkSecurityConfig="@xml/network_security_config" />
</manifest>
