<?xml version="1.0" encoding="utf-8"?>
<!-- Network security config (compiled into res/xml/ by the test). POSITIVE: base cleartext,
     user CAs trusted, one cleartext domain. The debug-overrides block is NOT a finding unless
     the app is debuggable. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">legacy.example</domain>
    </domain-config>
    <debug-overrides>
        <trust-anchors>
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>
